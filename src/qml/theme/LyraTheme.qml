import QtQuick

QtObject {
    id: theme
    // Cores base do Lyra (Temática Espacial)
    readonly property color background: "#05050A"    // O vazio espacial (Preto quase absoluto)
    readonly property color surface: "#121218"       // Fundo de painéis e barras
    readonly property color primary: "#9D4EDD"       // Roxo Nebulosa (Destaques)
    readonly property color textMain: "#FFFFFF"      // Branco estrela
    readonly property color textSecondary: "#8A8A93" // Cinza poeira cósmica
}